_compget_color_values(){
    COMPREPLY=($(compgen -W 'red green blue' -- "${cur}"))
}


# First check if ${prev} is an option that takes exactly one argument, then
# starting from the end, read backwards.  If word[cword-i] is an option that
# can take $i or more args, then that is the option we are completing.  However
# as soon as we encounter an argument that starts with '-' that is not one
# of these options, everything stops.  This is how argparse works also.
#
# It is technically possible to have aguments.
# - Choice arguments with choices that start with '-',
# - Using the --opt=-value
# The --opt=value syntax is not handled by the compgen generator
# and choices starting with '-' are also not handled.
_compget_get_completed_option(){
    case ${prev} in
        --bash-command) echo "${prev}" ; return ;;
        -d) echo "${prev}" ; return ;;
        --log-file) echo "${prev}" ; return ;;
        --xtrace-log) echo "${prev}" ; return ;;
    esac
    for((i=0;i<${#words[@]};i++)) ; do
        local word=${words[cword-i]}
        case ${word} in
            --init-files|-f|--init-commands|-c) echo "${word}" ; return ;;
            --color) if ((i<=3)) ; then echo "${word}" ; return ; fi ;;
            -*) break ;;
        esac
    done
}
complete -F _compget compget

_compget_d_values(){
    _filedir -d
}

