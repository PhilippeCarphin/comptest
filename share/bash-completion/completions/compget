#!/usr/bin/env bash # hint for editors

_compget_arg_options=(--init-files -f --bash-command -d --log-file --xtrace-log --init-commands -c --color)
_compget_flag_options=(-h --help --debug --load-bash-completion -l -x --verbose-ps4 --interact --generate-completion --cut-descriptions)
_compget_options=("${_compget_arg_options[@]}" "${_compget_flag_options[@]}")
declare -gA _compget_descriptions=(
    [-h]="show this help message and exit"
    [--help]="show this help message and exit"
    [--init-files]="Files to source before attempting completion"
    [-f]="Files to source before attempting completion"
    [--bash-command]="Bash command (default 'bash --norc')"
    [-d]="Working directory to be in"
    [--debug]="Set log level to DEBUG"
    [--load-bash-completion]="Load BASH completion from likely directories"
    [-l]="Load BASH completion from likely directories"
    [--log-file]="Log file"
    [--xtrace-log]="Log file for xtrace output"
    [-x]="Activate xtrace (set -x)"
    [--verbose-ps4]="Set verbose PS4.  Only useful if -x option is used"
    [--interact]="Take control of the shell after getting completions"
    [--init-commands]="init commands (done after sourcing init files)"
    [-c]="init commands (done after sourcing init files)"
    [--color]="Only for testing"
    [--generate-completion]="Generate completion for this script"
    [--cut-descriptions]="Cut descriptions and spaces from results"
)

_compget(){
    local cur prev words cword
    _init_completion || return

    local opt=$(_compget_get_completed_option)
    case $opt in
        -f|--init-files) _compget_init_files_values ;;
        --bash-command) _compget_bash_command_values ;;
        -d) _compget_d_values ;;
        --log-file) _compget_log_file_values ;;
        --xtrace-log) _compget_xtrace_log_values ;;
        -c|--init-commands) _compget_init_commands_values ;;
        --color) _compget_color_values ;;
        *) COMPREPLY=($(compgen -W "${_compget_options[*]}" -- "${cur}")) ;;
    esac

    _compget_add_descriptions_by_ref _compget_descriptions
}

_compget_add_descriptions_by_ref(){

    local -n _descriptions=$1

    if (( ${#COMPREPLY[@]} <= 1 )) ; then
        return
    fi

    local max_comp=0
    for c in "${COMPREPLY[@]}" ; do
        if ((${#c} > max_comp)) ; then
            max_comp=${#c}
        fi
    done

    local i max_desc_len=$((COLUMNS - max_comp - 4))
    if ((max_desc_len < 10 )) ; then
        return 1
    fi

    for((i=0;i<${#COMPREPLY[@]};i++));do
        local comp=${COMPREPLY[i]}
        local desc=${_descriptions[$comp]}

        if [[ -z ${desc} ]] ; then
            continue
        fi
        if ((${#desc} > max_desc_len)) ; then
            desc=${desc:0:$((max_desc_len-1))}
            desc+='…'
        fi
        printf -v COMPREPLY[i] "%-${max_comp}s (%s)" "${comp}" "${desc}"
    done

}
