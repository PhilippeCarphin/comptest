#!/usr/bin/env bash # hint for editors

_chef_arg_options=(-F)
_chef_flag_options=(-h --help --debug -d)
_chef_options=("${_chef_arg_options[@]}" "${_chef_flag_options[@]}")
_chef_subcommands=(cook prep)
declare -gA _chef_descriptions=(
    [-h]=" - : show this help message and exit"
    [--help]=" - : show this help message and exit"
    [--debug]="flag: Turn on debug logging"
    [-d]="flag: Turn on debug logging"
    [-F]="arg: Config file"
    [cook]="subcommand: Cook food"
    [prep]="subcommand: Prep food"
)

_chef_cook_arg_options=(--vessel -v --temp -t --bowl -b)
_chef_cook_flag_options=(-h --help)
_chef_cook_options=("${_chef_cook_arg_options[@]}" "${_chef_cook_flag_options[@]}")
declare -gA _chef_cook_descriptions=(
    [-h]=" - : show this help message and exit"
    [--help]=" - : show this help message and exit"
    [--vessel]="arg: The vessel to cook in"
    [-v]="arg: The vessel to cook in"
    [--temp]="arg: Temperature to cook at"
    [-t]="arg: Temperature to cook at"
    [--bowl]="arg: The bowl to empty into the cooking vessel"
    [-b]="arg: The bowl to empty into the cooking vessel"
)

_chef_prep_arg_options=(--bowl -b --vegetable -v)
_chef_prep_flag_options=(-h --help)
_chef_prep_options=("${_chef_prep_arg_options[@]}" "${_chef_prep_flag_options[@]}")
declare -gA _chef_prep_descriptions=(
    [-h]=" - : show this help message and exit"
    [--help]=" - : show this help message and exit"
    [--bowl]="arg: The bowl to put prepped vegetables into"
    [-b]="arg: The bowl to put prepped vegetables into"
    [--vegetable]="arg: The vegetable to prep"
    [-v]="arg: The vegetable to prep"
)

_chef(){
    local cur prev words cword
    _init_completion || return

    local subcommand subcommand_index
    for((i=0;i<${#words[@]};i++)) ; do
        case ${words[i]} in
            --debug|-d) ;;
            -F) ((i++)) ;;
            cook|prep) subcommand=${words[i]} ; subcommand_index=i; break ;;
        esac
    done

    if [[ -z ${subcommand} ]] ; then
        case $prev in
            -F)  : TODO ;;
            *) COMPREPLY=($(compgen -W "${_chef_subcommands[*]} ${_chef_options[*]}" -- "${cur}")) ;;
        esac
        _chef_add_descriptions_by_ref _chef_descriptions
    else
        _chef_${subcommand}
        _chef_add_descriptions_by_ref _chef_${subcommand}_descriptions
    fi
}

_chef_cook(){
    local cur prev words cword
    _init_completion || return

    case $prev in
        -v|--vessel) COMPREPLY+=($(compgen -W "pan pot" -- "${cur}")) ;;
        -t|--temp) COMPREPLY+=($(compgen -W "high medium low" -- "${cur}")) ;;
        -b|--bowl) COMPREPLY+=($(compgen -W "large small" -- "${cur}")) ;;
        *) COMPREPLY=($(compgen -W "${_chef_cook_options[*]}" -- "${cur}")) ;;
    esac
    _chef_cook_positional
}

_chef_cook_positional(){
    position=$(_chef_cook_get_position)
    case $position in
        0) : TODO ;;
        1) : TODO ;;
        *) : TODO ;;
    esac
}

_chef_cook_get_position(){
    #
    # Maybe look at what git completion does, they must have a good way
    # Otherwise
    # - Walk backwards from the end counting up
    # - Stop when we encounter a non-posarg?
    # - No I think we can allow intersperced posargs
    # - if it's not an option, upcount
    # - it it is an flag option, skip
    # - if it's an option that takes an argument, downcount
    #   because we upcounted for something that was actually
    #   the argument of an option.
    #
    # And that's it!  Write it in bash first and do generate it.
    #
    # For options that have like nargs=*, I think we can, at each interation
    # use like get_completed_option but you know, I don' even like those.
    #
    # The vact that calling get_completed_option for each argument is N^2
    # doesn't matter since we're going to have like no more than 15 arguments.
    #
    # Positional arguments are somewhat less common with argparse parsers
    # but they are still a thing and I think my algorithm idea above for getting
    # the position we are completing is sound.
    #
    # It would need a switch to toggle whether posargs *can* be intersperced
    # because the tool itslef might not allow this.
    #
    # TESTING: I can start by writing a function that takes ARGV as an argument
    # and just returns the position number of the argument we are completing.
    #
    local words=("$@") cword=$(($#-1))
    local pos
    for((i=$cword;i<${subcommand_index};i--));do
        case ${words[i]} in
            --vessel) ((pos--)) ;;
            --debug) : skip ;;
            *) ((pos++)) ;;
        esac
    done
    # BUT SHIT: We need to consider the subcommands.  So maybe we get the index
    # of the word that is the subcommand and stop before that

}


_chef_prep(){
    local cur prev words cword
    _init_completion || return

    case $prev in
        -b|--bowl) COMPREPLY+=($(compgen -W "large small" -- "${cur}")) ;;
        -v|--vegetable) COMPREPLY+=($(compgen -W "onion carrot potato" -- "${cur}")) ;;
        *) COMPREPLY=($(compgen -W "${_chef_prep_options[*]}" -- "${cur}")) ;;
    esac
}

_chef_add_descriptions_by_ref(){
    local -n _descriptions=$1

    if (( ${#COMPREPLY[@]} <= 1 )) ; then
        return
    fi

    local max_comp=0
    for c in "${COMPREPLY[@]}" ; do
        if ((${#c} > max_comp)) ; then
            max_comp=${#c}
        fi
    done

    local i max_desc_len=$((COLUMNS - max_comp - 4))
    if ((max_desc_len < 10 )) ; then
        return 1
    fi

    for((i=0;i<${#COMPREPLY[@]};i++));do
        local comp=${COMPREPLY[i]}
        local desc=${_descriptions[$comp]}

        if [[ -z ${desc} ]] ; then
            continue
        fi
        if ((${#desc} > max_desc_len)) ; then
            desc=${desc:0:$((max_desc_len-1))}
            desc+='…'
        fi
        printf -v COMPREPLY[i] "%-${max_comp}s (%s)" "${comp}" "${desc}"
    done
}
complete -F _chef chef
