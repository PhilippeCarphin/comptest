_chef_cook(){
    case $prev in
        --vessel) _chef_cook_vessel_values ;;
        --temp) _chef_cook_temp_values ;;
        --bowl) _chef_cook_bowl_values ;;
        *) COMPREPLY=($(compgen -W "${_chef_cook_options[*]}" -- "${cur}")) ;;
    esac
}

_chef_prep(){
    case $prev in
        --vegetable) _chef_prep_vegetable_values ;;
        --bowl) _chef_prep_bowl_values ;;
        *) COMPREPLY=($(compgen -W "${_chef_prep_options[*]}" -- "${cur}")) ;;
    esac
}
_chef_prep_vegetable_values(){
    COMPREPLY=($(compgen -W "onion carrot potato" -- "${cur}"))
}

_chef_cook_vessel_values(){
    COMPREPLY=($(compgen -W "pan pot" -- "${cur}"))
}

_chef_cook_temp_values(){
    COMPREPLY=($(compgen -W "low medium high" -- "${cur}"))
}

_chef_cook_bowl_values(){
    COMPREPLY=($(compgen -W "large small" -- "${cur}"))
}

_chef_prep_bowl_values(){
    COMPREPLY=($(compgen -W "large small" -- "${cur}"))
}

