_compget_color_values(){
    COMPREPLY=($(compgen -W 'red green blue' -- "${cur}"))
}

_compget_get_completed_option(){
    case ${prev} in
        --bash-command) echo --bash-command ; return ;;
        -d) echo -d ; return ;;
        --log-file) echo --log-file ; return ;;
        --xtrace-log) echo --xtrace-log ; return ;;
    esac

    for ((i=0;i<${#words[@]};i++)) ; do
        case ${words[cword-i]} in
            --init-files|-f) echo "--init-files" ; return ;;
            -*) break 2 ;;
        esac
    done

    for ((i=0;i<${#words[@]};i++)) ; do
        case ${words[cword-i]} in
            --init-commands|-c) echo "--init-commands" ; return ;;
            -*) break 2 ;;
        esac
    done

    for ((i=0; i<=3 && i<${#words[@]} ;i++)) ; do
        case ${words[cword-i]} in
            --color) echo "--color" ; return ;;
            -*) break 2 ;;
        esac
    done
}
complete -F _compget compget
